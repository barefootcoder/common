#! /bin/bash
set -euo pipefail

# Find a working SSH agent socket.
# Outputs the socket path to stdout; diagnostics to stderr.
# Exit 0 on success, 1 on failure.

ME=$(basename "$0")

verbose=false
[[ ${1:-} == -v || ${1:-} == --verbose ]] && verbose=true

# Test if a socket actually works (not just exists)
function test-socket
{
    local socket=$1

    if [[ ! -S $socket ]]
    then
        $verbose && echo "# $socket: not a socket" >&2
        return 1
    fi

    # ssh-add -l exit codes: 0 = has keys, 2 = can't connect, 124 = timeout.
    # Exit 1 is AMBIGUOUS: ssh-add returns it both for "agent has no
    # identities" (a working but empty agent) AND for "communication with
    # agent failed" (a dead forwarded socket whose file still lingers in
    # /tmp).  We must disambiguate on the message, or we accept dead sockets
    # as working and pick the wrong one -- which silently breaks ssh-sock-reset.
    local out result=0
    out=$( timeout 2 env SSH_AUTH_SOCK="$socket" /bin/ssh-add -l 2>&1 ) || result=$?

    local ok=false
    case $result in
        0)   $verbose && echo "# $socket: working (has keys)" >&2
             ok=true
             ;;
        1)   if [[ $out == *"no identities"* ]]
             then
                 $verbose && echo "# $socket: working (no keys)" >&2
                 ok=true
             else
                 $verbose && echo "# $socket: dead ($out)" >&2
             fi
             ;;
        2)   $verbose && echo "# $socket: connection failed" >&2
             ;;
        124) $verbose && echo "# $socket: timeout (likely stale)" >&2
             ;;
        *)   $verbose && echo "# $socket: error ($result)" >&2
             ;;
    esac

    $ok
}

# Find all SSH agent sockets, newest first
function find-ssh-sockets
{
    find /tmp /run/user/$(id -u) \( -path "*/ssh*" -o -path "*/.ssh*" \) -type s -printf '%T@ %p\n' 2>/dev/null \
        | sort -rn | cut -d' ' -f2-
}

# Is the temp dir (where sshd places a forwarded agent socket) writable?
# A read-only root makes /tmp unwritable, so sshd cannot create the socket and
# NO agent ever appears here -- a different problem, with a different fix, than
# a missing local agent.  Detecting it lets us say so instead of misdirecting
# the user into a reconnect loop that cannot possibly help.
function tmpdir-writable
{
    local probe
    probe=$( mktemp "${TMPDIR:-/tmp}/.ssh-agent-find.XXXXXX" 2>/dev/null ) || return 1
    rm -f "$probe"
    return 0
}


########
# MAIN #
########

# Early out: if current SSH_AUTH_SOCK already works, just report it
if [[ ${SSH_AUTH_SOCK:-} ]] && test-socket "$SSH_AUTH_SOCK"
then
    $verbose && echo "# Current SSH_AUTH_SOCK is already working" >&2
    echo "$SSH_AUTH_SOCK"
    exit 0
fi

# Search for a working socket, trying newest first
for socket in $(find-ssh-sockets)
do
    if test-socket "$socket"
    then
        echo "$socket"
        exit 0
    fi
done

# Nothing found — provide diagnostics
if [[ ${SSH_CONNECTION:-} ]]
then
    if ! tmpdir-writable
    then
        # Non-writable temp dir trap: sshd could not create a forwarded agent
        # socket, so no agent will ever appear here -- a reconnect cannot help,
        # and the generic forwarding advice below would only misdirect.  Name
        # the actual cause from the mount options instead of guessing.
        tmp_opts=$( findmnt -no OPTIONS --target "${TMPDIR:-/tmp}" 2>/dev/null ) || tmp_opts=
        echo "# ERROR: ${TMPDIR:-/tmp} is NOT writable -- sshd cannot create a forwarded agent" >&2
        echo "# socket there, so no agent appears here.  Reconnecting will NOT fix this." >&2
        if [[ ,$tmp_opts, == *,ro,* ]]
        then
            echo "# CAUSE: the filesystem is mounted READ-ONLY (options: $tmp_opts)." >&2
            echo "#        Fix: fsck the root device, then reboot.  (Vagrant dev sandbox? see the" >&2
            echo "#        home-network aidoc 'summary:vagrant-sandbox-readonly-root-fsck.md'.)" >&2
        else
            echo "# CAUSE: not a read-only mount (options: ${tmp_opts:-unknown}) -- check for a" >&2
            echo "#        full disk ('df ${TMPDIR:-/tmp}') or bad permissions on that directory." >&2
        fi
        echo "#   Confirm fs state: findmnt -no OPTIONS /" >&2
    else
        echo "# WARNING: In an SSH session but no working SSH agent found" >&2
        echo "# If you intended to use agent forwarding:" >&2
        echo "#   1. Run on your LOCAL machine: ssh-sock-reset (or source ssh-agent-env)" >&2
        echo "#   2. Reconnect with: ssh -A <hostname>" >&2
        echo "# Otherwise, start a local agent with: eval \$(ssh-agent)" >&2
    fi
else
    agents=$( pgrep -u $(id -u) ssh-agent ||: )
    if [[ $agents ]]
    then
        echo "# $ME: SSH agent running (PIDs: $(echo $agents | tr '\n' ' ')) but no working sockets" >&2
        echo "# Suggestion: pkill ssh-agent && eval \$(ssh-agent)" >&2
    else
        echo "# $ME: no SSH agent found" >&2
        echo "# Suggestion: eval \$(ssh-agent)" >&2
    fi
fi

exit 1

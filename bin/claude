#!/usr/bin/env perl

use 5.14.0;
use warnings;
use autodie ':all';

use PerlX::bash;


my $ME = 'claude';

# find `claude`
my $CLAUDE_PATH;
foreach (map { "$_/claude" } glob("~/.claude/local/bin"), glob("~/.local/bin"), qw< /var/npm/bin /usr/local/bin >)
{
	if (-x) { $CLAUDE_PATH = $_; last; }
}
$CLAUDE_PATH or die "$ME: cannot locate claude script\n";

# Add AI helper scripts directory to path
$ENV{PATH} = bash \string => (addpath => glob("~/common/conf/ai/devtools"));

# Add Go binaries to path (for jira-cli, etc.)
$ENV{PATH} = bash \string => (addpath => glob("~/go/bin"));

# Verify local memory; create if necessary and possible
my $localmem = 'CLAUDE.local.md';
if (not -e $localmem)
{
	# doesn't exist; can we find something to symlink to?
	if ( $ENV{CE_REMOTE_USERNAME} )					# for work repos, this is how we find personal files
	{
		my $personal_mem = "aidoc/CLAUDE-$ENV{CE_REMOTE_USERNAME}.md";
		symlink $personal_mem, $localmem if -f $personal_mem;
	}
}

# Ensure terminal size is correctly propagated through screen
# screen -Q info format: (cursor_col,cursor_row)/(width,height)+scrollback
# Suppress the message line flash by temporarily setting msgwait to 0
# (same technique used in screen-windowlist and screen-bufsave)
system 'screen', '-X', 'msgwait', '0';
chomp(my $screen_info = `screen -Q info 2>/dev/null`);
system 'screen', '-X', 'msgwait', '3';
if ($screen_info =~ m{/\((\d+),(\d+)\)})
{
	$ENV{COLUMNS} = $1;
	$ENV{LINES} = $2;
}

$ENV{TERM} = 'screen-256color';
$ENV{CLAUDE_CODE_DISABLE_TERMINAL_TITLE} = 1;

# Clean up stale tmux sockets from previous launches.
# Per-PID sockets accumulate as dead files when servers exit.
my $tmux_dir = "/tmp/tmux-$>/";
if (-d $tmux_dir)
{
	for my $sock (glob("${tmux_dir}claude-*"))
	{
		(my $name = $sock) =~ s{.*/}{};
		# if no server is listening, the socket is stale
		`tmux -L \Q$name\E has-session 2>/dev/null`;
		unlink $sock if $?;
	}
}

# Wrap Claude in tmux to absorb TUI redraws.
# tmux maintains an internal screen grid and only forwards diffs to the outer
# terminal (screen), which dramatically reduces the visible repaint churn
# when Claude Code redraws its entire viewport over ssh.
my $tmux_socket = "claude-$$";
my $tmux_conf = glob("~/common/conf/tmux-claude.conf");
exec 'tmux',
	'-u',									# force UTF-8 (remote machines may not advertise it via locale)
	'-L', $tmux_socket,						# per-PID socket so each launch gets a fresh server (reads current config)
	'-f', $tmux_conf,
	'new-session',
	$CLAUDE_PATH, @ARGV;

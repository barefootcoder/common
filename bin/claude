#!/usr/bin/env perl

use 5.14.0;
use warnings;
use autodie ':all';

use Cwd ();


my $ME = 'claude';

# Versions known to be broken; the wrapper will refuse to execute these and
# re-pin the claude symlink to the newest known-good version available on disk.
# Only add a version here when a regression actually bites us; remove it once
# we're past it (or once we've cleaned the binary off disk).
#   2.1.120 -- crashes with `UKH is not a function` when resuming a session
#              via `claude -c` (and likely other resume paths)
my @BAD_VERSIONS = ('2.1.120');

# find `claude`
my $CLAUDE_PATH;
foreach (map { "$_/claude" } glob("~/.claude/local/bin"), glob("~/.local/bin"), qw< /var/npm/bin /usr/local/bin >)
{
	if (-x) { $CLAUDE_PATH = $_; last; }
}
$CLAUDE_PATH or die "$ME: cannot locate claude script\n";

# Add directories to PATH:
#   ~/.local/bin                    (suppresses "not in your PATH" nag from native install)
#   ~/common/conf/ai/devtools       (AI helper scripts)
#   ~/go/bin                        (jira-cli, etc.)
# Done in pure Perl to avoid spawning bash for each; mirrors semantics of `addpath`:
# append, dedup, skip non-existent.
$ENV{PATH} .= ":$_" foreach												# as always, read from the bottom up
	grep { not ":$ENV{PATH}:" =~ /:\Q$_\E:/                }
	grep { -d                                              }
	map  { glob($_)                                        }
	   qw< ~/.local/bin ~/common/conf/ai/devtools ~/go/bin >;

# Verify local memory; create if necessary and possible
my $localmem = 'CLAUDE.local.md';
if (not -e $localmem)
{
	# doesn't exist; can we find something to symlink to?
	if ( $ENV{CE_REMOTE_USERNAME} )					# for work repos, this is how we find personal files
	{
		my $personal_mem = "aidoc/CLAUDE-$ENV{CE_REMOTE_USERNAME}.md";
		symlink $personal_mem, $localmem if -f $personal_mem;
	}
}

# Ensure terminal size is correctly propagated through screen
# screen -Q info format: (cursor_col,cursor_row)/(width,height)+scrollback
# Suppress the message line flash by temporarily setting msgwait to 0
# (same technique used in screen-windowlist and screen-bufsave)
system 'screen', '-X', 'msgwait', '0';
chomp(my $screen_info = `screen -Q info 2>/dev/null`);
system 'screen', '-X', 'msgwait', '3';
if ($screen_info =~ m{/\((\d+),(\d+)\)})
{
	$ENV{COLUMNS} = $1;
	$ENV{LINES} = $2;
}

# Prevent tmux from running its command through tcsh, which sources .tcshrc
# and rebuilds PATH from scratch, discarding our additions above.
$ENV{SHELL} = '/bin/bash';

$ENV{TERM} = 'screen-256color';
$ENV{CLAUDE_CODE_DISABLE_TERMINAL_TITLE} = 1;

# Clean up stale tmux sockets from previous launches.
# Per-PID sockets accumulate as dead files when servers exit.
my $tmux_dir = "/tmp/tmux-$>/";
if (-d $tmux_dir)
{
	for my $sock (glob("${tmux_dir}claude-*"))
	{
		(my $name = $sock) =~ s{.*/}{};
		# if no server is listening, the socket is stale
		`tmux -L \Q$name\E has-session 2>/dev/null`;
		unlink $sock if $?;
	}
}

# Auto-update is unreliable; check for updates ourselves, but cache the check
# to avoid paying the network round-trip on every launch.  Once per day is plenty.
my $update_stamp = "/tmp/claude-update-stamp-$>";
if (!-e $update_stamp || -M $update_stamp > 1)				# -M is age in days
{
	my $update_out = `\Q$CLAUDE_PATH\E update 2>&1`;
	say $1 if $update_out =~ /^(Successfully .+)$/m;
	open my $fh, '>', $update_stamp;						# touch stamp file
}

# Reject any version on the blocklist: re-pin the symlink to the newest good
# version on disk.  Runs every launch, so it catches both fresh updates that
# just activated a bad version and prior runs that left the symlink in a bad
# state.
my $real_path = Cwd::abs_path($CLAUDE_PATH);
if ($real_path && $real_path =~ m{^(.*/versions)/([0-9]+\.[0-9]+\.[0-9]+)$})
{
	my ($versions_dir, $current) = ($1, $2);
	if (grep { $_ eq $current } @BAD_VERSIONS)
	{
		my %bad = map { $_ => 1 } @BAD_VERSIONS;
		my @good = sort { _vkey($b) cmp _vkey($a) }		# newest first
		           grep { !$bad{$_} }
		           map  { m{/([^/]+)$} ? $1 : () }
		           glob("$versions_dir/*");
		@good or die "$ME: $current is blocklisted and no good fallback in $versions_dir\n";
		warn "$ME: $current is blocklisted; re-pinning to $good[0]\n";
		-l $CLAUDE_PATH or die "$ME: cannot re-pin: $CLAUDE_PATH is not a symlink\n";
		unlink $CLAUDE_PATH;
		symlink "$versions_dir/$good[0]", $CLAUDE_PATH;
	}
}

sub _vkey
{
	my @p = (split /\./, $_[0], 3);
	sprintf '%05d.%05d.%05d', $p[0]||0, $p[1]||0, $p[2]||0;
}

# Wrap Claude in tmux to absorb TUI redraws.
# tmux maintains an internal screen grid and only forwards diffs to the outer
# terminal (screen), which dramatically reduces the visible repaint churn
# when Claude Code redraws its entire viewport over ssh.
my $tmux_socket = "claude-$$";
my $tmux_conf = glob("~/common/conf/tmux-claude.conf");
exec 'tmux',
	'-u',									# force UTF-8 (remote machines may not advertise it via locale)
	'-L', $tmux_socket,						# per-PID socket so each launch gets a fresh server (reads current config)
	'-f', $tmux_conf,
	'new-session',
	$CLAUDE_PATH, @ARGV;

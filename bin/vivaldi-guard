#! /bin/bash
#
# vivaldi-guard — launch Vivaldi only when no NoMachine session is active.
#
# Haven's Raptor Lake Iris Xe GPU has hard-crashed the laptop when Vivaldi's
# heavy profile is loaded while NoMachine is streaming/capturing the display.
# The Feb 2026 kernel upgrade (6.1-oem → 6.8) fixed the i915 driver bugs but
# didn't leave enough GPU headroom for that combined load; the crash pattern
# recurred on 2026-04-23.  This wrapper refuses to launch Vivaldi while a
# NoMachine session is active (either direction) and explains why.
#
# See ~/common/aidoc/projects/home-network/summary:haven-fstab-uuid-and-vivaldi-guard.md
#
# On Haven, hardware instability has dropped the crash threshold below Vivaldi's
# default GPU-accelerated load even without NoMachine (see
# summary:vivaldi-7.9-upgrade-and-haven-instability.md). Until the battery
# replacement / repaste / cap inspection is done, Vivaldi must launch with
# --disable-gpu on Haven. This wrapper injects that flag automatically so panel
# launchers (which go through this script) stop crashing the box.

: ${ME:=${0##*/}}

# Detect an active NoMachine session, in any role (see project doc
# summary:haven-jun10-video-crash.md "Why vivaldi-guard does not prevent this"):
#   nxagent       : server side of a VIRTUAL (headless) session
#   nxplayer.bin  : client-side viewer -- the box you are viewing FROM
#   nxnode.bin -H : server side of a PHYSICAL-desktop shadow -- the box being
#                   viewed, capturing+encoding its real framebuffer (the
#                   GPU/display load that crashes Haven). Anchor on the -H flag:
#                   a bare nxnode.bin daemon worker runs at all times, so
#                   matching plain 'nxnode' would block Vivaldi permanently.
# The client checks (nxagent/nxplayer) fire on whichever box is viewing, so in
# the usual both-ways-paired session the guard already trips on both ends. The
# nxnode.bin -H clause is what catches a ONE-directional session on the served
# box itself (viewed but not viewing back) -- the exact case that ran Vivaldi
# unguarded on Haven during the 2026-06-10 crash.
if pgrep -f 'nxagent|nxplayer\.bin|nxnode\.bin -H' >/dev/null 2>&1
then
	title='Vivaldi launch blocked'
	msg='<span foreground="red" size="x-large"><b>NoMachine is active.</b></span>'$'\n\n'
	msg+='Launching Vivaldi while a NoMachine session is running has caused hard crashes on Haven (hardware-off, no graceful shutdown).'$'\n\n'
	msg+='Disconnect NoMachine first and try again, or use Chrome Ungoogled instead.'

	zenity --error --title="$title" --width=450 --text="$msg" &
	sleep 1
	xdotool search --name "$title" windowmove 1550 50 2>/dev/null || true
	wmctrl -r "$title" -b add,above,sticky 2>/dev/null || true
	exit 1
fi

# Haven-specific: prepend --disable-gpu unless caller (or this script's earlier
# self-invocation) has already supplied it.
extra_args=()
if [[ "$(hostname -s)" == "haven" ]]
then
	has_disable_gpu=0
	for arg in "$@"
	do
		if [[ "$arg" == "--disable-gpu" || "$arg" == "--disable-gpu="* ]]
		then
			has_disable_gpu=1
			break
		fi
	done
	(( has_disable_gpu )) || extra_args+=(--disable-gpu)
fi

exec /usr/bin/vivaldi-stable "${extra_args[@]}" "$@"

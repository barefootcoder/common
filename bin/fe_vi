#! /usr/bin/env perl

BEGIN { eval { require 5.14.0 } or exec "vim", @ARGV }
use 5.14.0;
use warnings FATAL => 'all';

my $svn_line_sep = qr{ -- .* ignored-- $ }x;
my $cvs_line_sep = "CVS: " . "-" x 70;
my $git_line_sep = quotemeta('# Please enter the commit message for your changes.');

my @lines;
my $found_sep;
if ($ARGV[0] and open(FILE, $ARGV[0]))
{
	# Store only the first 5 lines (for the greps below, and to cap RAM), but
	# keep scanning for a commit-message separator: it sits at line 2 for a fresh
	# commit, but well below an existing message when amending.  Stop the moment
	# we find one, and never read past 200 lines so editing a huge file stays cheap.
	my $scan_limit = 200;
	while ($scan_limit-- and defined(my $line = <FILE>))
	{
		push @lines, $line if @lines < 5;
		if ($line =~ /^($svn_line_sep|$cvs_line_sep|$git_line_sep)/)
		{
			$found_sep = 1;
			last;
		}
	}
	close(FILE);
}


if ($ARGV[0] =~ m|^/tmp/claude|)
{
	exec 'vim', '+', '-c', 'set paste', '-c', 'startinsert!', @ARGV;
}
if (not @lines)
{
	exec "vim", @ARGV;
}
elsif (grep { /<html>/i } @lines)
{
	say STDERR "using web startup (checked ", scalar(@lines), " lines)";
	exec qw<vim -u /home/buddy/.viwebrc>, @ARGV;
}
elsif (grep { /<\w+ METAx>/i } @lines)
{
	exec qw<vim -s /home/buddy/.vim-genhtml>, @ARGV;
}
elsif (grep { /(PRE-QA|TESTING) NOTES/i } @lines)
{
	exec 'vim', '+', '-c', 'set comments=', @ARGV;
}
elsif ($found_sep)
{
	# Existing message (e.g. amending): land at the top in normal mode.  Empty
	# message (fresh commit, blank line 1): drop into insert mode.
	my @insert = $lines[0] eq "\n" ? ('-c', 'startinsert') : ();
	exec 'vim', '+1', @insert, '-c', 'set textwidth=95', @ARGV;
}
else
{
	exec "vim", @ARGV;
}

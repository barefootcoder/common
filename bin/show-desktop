#! /usr/bin/env perl

use myperl::Pxb;
use autodie ':all';

use List::AllUtils qw< pairkeys pairgrep pairmap >;

const my $CONNECT  => '/usr/NX/bin/nxplayer';
const my $PREVIOUS => file('/tmp/previously-shown-desktop');
const my $LOG      => file('~/local/log/show-desktop.log');	# duplicate-session heisenbug instrumentation (2026-05-28); remove once caught
const my $ICONS    =>
{
	ERROR	=> '/usr/share/icons/Humanity/status/48/error.svg',
	INFO	=> '/usr/share/icons/Humanity/status/48/info.svg',
};

const my $WORK_DESKTOP =>
{
	zadash	=>	'caemlyn',
	haven	=>	'avalir',
};
const my $HOME_DESKTOP => { reverse %$WORK_DESKTOP };


opts <<'-';
	[-D] <machine>
	-D : debug mode (implies -v)
	<machine>  : which host to show desktop for
-
#$OPT{v} = 1 if $OPT{D};
$OPT{n} //= 1;

my $host = shift // usage_error('must supply host');

# --- instrumentation: record every invocation so the duplicate-session heisenbug is diagnosable ---
my $arg = $host;												# raw target before WORK/HOME/PREVIOUS resolution
dbg('', '==== ' . now->strftime('%Y-%m-%d %H:%M:%S') . " : `show-desktop $arg` on " . sh('hostname'));


# Get rid of any stray disconnected windows before opening new ones.
# (ChatGPT helped write this: https://chat.openai.com/share/51318917-e9ad-4370-8fa6-5f814dcd8f2d)
my @windows = sh(wmctrl => -l =>);
dbg('-- windows before cleanup (wmctrl -l):', map { "     $_" } @windows);
my @stray =
		pairgrep { $b eq "NoMachine"      }
		map      { (split(" ",$_,4))[0,3] } @windows
;
dbg('-- cleanup closes (title eq "NoMachine"): ' . (@stray ? join(', ', pairmap { "$a" } @stray) : 'nothing'));
sh(wmctrl => -ic => $_) foreach pairkeys @stray;


my $me = sh('hostname');
if ($host eq 'PREVIOUS')
{
	-r $PREVIOUS or notify(ERROR => "No previous desktop yet.");
	$host = $PREVIOUS->slurp;
}
else
{
	if ($host eq 'WORK')
	{
		if ( exists $WORK_DESKTOP->{$me} )
		{
			$host = $WORK_DESKTOP->{$me};
		}
		else
		{
			if ( exists $HOME_DESKTOP->{$me} )
			{
				$host = $me;						# trigger error below
			}
			else
			{
				notify(ERROR => "show-desktop: couldn't find work desktop for $me");
			}
		}
	}
	elsif ($host eq 'HOME')
	{
		if ( exists $HOME_DESKTOP->{$me} )
		{
			$host = $HOME_DESKTOP->{$me};
		}
		else
		{
			if ( exists $WORK_DESKTOP->{$me} )
			{
				$host = $me;						# trigger error below
			}
			else
			{
				notify(ERROR => "show-desktop: couldn't find home desktop for $me");
			}
		}
	}
	elsif ($host eq uc $host)
	{
		notify(ERROR => "show-desktop: called with unknown arg [$host]");
	}

	if ($host eq $me)
	{
		my $cur_window = sh( xdotool => getactivewindow => getwindowname => );
		if ($cur_window =~ /(\w+) - NoMachine/)
		{
			notify(ERROR => "This should not be possible!");
		}
		else
		{
			notify(INFO => "Already on ${host}'s desktop.");
			exit;
		}
	}

	$PREVIOUS->spew($host);
}

my $rdesktop = "\u$host - NoMachine";			# NoMachine 9.x flipped the title order from "NoMachine - haven" to "Haven - NoMachine"
# Find the existing session via wmctrl, NOT `xdotool search --name`.  xdotool's
# search walks the *entire* X window tree calling XGetWindowProperty on each node;
# if any transient window (notification, tooltip, dying player child) is destroyed
# mid-walk, the X server returns a fatal BadWindow error and xdotool aborts with
# empty output -- which this script misread as "no existing session" and launched
# a duplicate.  wmctrl reads _NET_CLIENT_LIST in one shot and is race-immune.
# (Diagnosed 2026-05-28: xdotool search was failing ~50% of the time.)
my @decision = sh(wmctrl => -l =>);
my ($win) =
		pairkeys
		pairgrep { $b =~ /\Q$rdesktop\E/  }		# substring match, as `xdotool search --name` did
		map      { (split(" ",$_,4))[0,3] } @decision
;
# --- instrumentation: capture the exact decision state (post-cleanup) ---
dbg("-- resolved target host: $host  (looking for window titled \"$rdesktop\")");
dbg('-- windows at decision (wmctrl -l):', map { "     $_" } @decision);
if ($win)
{
	dbg("-> MATCH: found existing window [$win] -- focusing existing session");
	my $cur_desktop = sh(xdotool => get_desktop => );
	sh(xdotool => set_desktop_for_window => $win, $cur_desktop);
	sh(wmctrl => -ir => $win, -b => 'add,fullscreen');
	sh(xdotool => windowactivate => '--sync' => $win);
	sh(xdotool => click => '--window' => $win, 1);
}
else
{
	dbg("-> NO MATCH: no window titled \"$rdesktop\" in the wmctrl list above -- launching a NEW session");
	my $machine = file("~/NoMachine/\u$host.nxs");
	sh($CONNECT => $machine);
}


# Append-only diagnostic log.  Best-effort: a logging failure must never abort
# the actual desktop switch, so everything is wrapped in eval.  Each arg is one
# line.  Remove this sub (and its callers + the $LOG const) once the
# duplicate-session heisenbug is caught.
sub dbg
{
	eval
	{
		my $dir = $LOG->parent;
		$dir->mkpath unless -d $dir;
		$LOG->append(map { "$_\n" } @_);
		1;
	};
}

sub notify
{
	my ($type, $msg) = @_;
	exists $ICONS->{$type} or notify(ERROR => "show-desktop: called `notify` with an unknown type [$type]");
	my $delay = $type eq 'ERROR' ? 5000 : 3000;
	sh('notify-send' => -t => $delay, -i => $ICONS->{$type}, $msg);
	exit 1 if $type eq 'ERROR';
}

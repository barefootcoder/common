#!/bin/bash
source bash_funcs

if [[ ! $SANDBOX ]]
then
	die '$SANDBOX not set; try `resrc`'
elif [[ $SANDBOX == *" "* ]]
then
	die '$SANDBOX set to error string (check AWS creds)'
fi

wrapper=$(mktemp -t ssh-quin-XXXXXX)
cat > $wrapper <<'WRAPPER'
#!/bin/bash
logfile=/tmp/term-quin.log

# Prefer Tailscale direct SSH (avoids SSM data corruption issues)
quin_ip=$(tailscale status 2>/dev/null | awk '/quin-/{print $1}')
declare -a ssh_opts=( -v )
if [[ $quin_ip ]]
then
	echo "[$(date)] Connecting via Tailscale ($quin_ip)" >> $logfile
	ssh_opts=( "${ssh_opts[@]}" -A -p 8822 -o ServerAliveInterval=60 -o ServerAliveCountMax=3 )
	ssh "${ssh_opts[@]}" $CE_REMOTE_USERNAME@$quin_ip 2>> $logfile
else
	echo "[$(date)] Tailscale unavailable, falling back to SSM" >> $logfile
	$CEROOT/devtools/cessh -D "${ssh_opts[@]}" $SANDBOX 2>> $logfile
fi

exitcode=$?
echo "[$(date)] Connection ended with exit code: $exitcode" >> $logfile
rm -f $0
WRAPPER
chmod +x $wrapper

myterm -D Main -s -M Quin cityofgold 125x50-40+107 $wrapper

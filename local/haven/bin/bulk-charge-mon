#! /usr/bin/perl
#
# bulk-charge-mon -- warn when Haven's battery is bulk-charging (drawing high
# charge current), the load that -- stacked with the GPU/CPU load of video over
# NoMachine -- crashed the box on 2026-06-10.  A near-flat 40%-health pack
# bulk-charges at a constant ~20W; that on top of the display load pushed the
# flaky office-ac adapter past its limit.
#
# Two modes:
#   bulk-charge-mon          daemon: poll BAT0, notify on bulk-charge onset/end
#   bulk-charge-mon status   one-shot: print whether it's bulk-charging right now
#
# The onset notification is PERSISTENT (expire-time 0): the bubble stays up the
# whole time it's bulk-charging, so you can't miss "still charging" by glancing
# late.  When it tapers, that same bubble is replaced in place with a transient
# all-clear.  For a definitive manual check any time, run `bulk-charge-mon
# status` (or `tail ~/local/log/bulk-charge-mon.log` for the on/off history).
#
# See aidoc/projects/home-network/summary:haven-jun10-video-crash.md
#
# Launched pidfile-guarded from local/haven/bin/termstart, like viv-mon; dies on
# a crash/reboot, restarted by the next termstart.  Core Perl only -- a bare
# shebang is fine, no launch-perl / PERL5LIB / CPAN.

use strict;
use warnings;

my $BAT     = '/sys/class/power_supply/BAT0';
my $PIDFILE = "$ENV{HOME}/.bulk-charge-mon.pid";
my $LOG     = "$ENV{HOME}/local/log/bulk-charge-mon.log";
my $POLL    = 20;       # seconds between samples (bulk charge lasts many minutes)

# Hysteresis on charge power (watts into the battery): enter "bulk" above ENTER,
# leave below EXIT.  CC-phase charging of a depleted pack sits near ~20W; taper
# (CV phase, ~80%+) and topped-off both fall well under EXIT.  The gap keeps a
# reading hovering near the line from flapping the notification.
my $ENTER = 15.0;
my $EXIT  = 10.0;

# The gdbus Notify call needs the user's session bus; DISPLAY alone isn't
# enough for a detached process, so point at the standard systemd user bus too.
my $uid = $<;
$ENV{DISPLAY}                  = ':0';
$ENV{DBUS_SESSION_BUS_ADDRESS} ||= "unix:path=/run/user/$uid/bus";

sub rd
{
	my ($f) = @_;
	open my $fh, '<', "$BAT/$f" or return undef;
	my $v = <$fh>;
	close $fh;
	chomp $v if defined $v;
	return $v;
}

# charge power in watts = current_now (uA) * voltage_now (uV); 0 if unreadable
sub charge_watts
{
	my $i = rd('current_now');
	my $v = rd('voltage_now');
	return 0 unless defined $i and defined $v;
	return ($i / 1e6) * ($v / 1e6);
}

# --- manual query mode: `bulk-charge-mon status` -------------------------------
# One-shot snapshot (no pidfile, no daemon), using the same threshold the daemon
# uses, so a manual check always agrees with what the notifications would say.
if (@ARGV and $ARGV[0] eq 'status')
{
	my $status = rd('status')   // '?';
	my $pct    = rd('capacity') // '?';
	my $w      = charge_watts;
	my $bulk   = ($status eq 'Charging' and $w >= $ENTER) ? 'YES' : 'no';
	printf "battery=%s%%  status=%s  charge=%.1fW  bulk-charging=%s  (threshold %.0fW)\n",
			$pct, $status, $w, $bulk, $ENTER;
	exit 0;
}

# --- daemon mode ---------------------------------------------------------------
open my $pf, '>', $PIDFILE or die "$0: cannot write $PIDFILE: $!\n";
print $pf "$$\n";
close $pf;

sub logline
{
	my ($msg) = @_;
	my @t = localtime;
	my $ts = sprintf '%04d-%02d-%02dT%02d:%02d:%02d',
			$t[5] + 1900, $t[4] + 1, $t[3], $t[2], $t[1], $t[0];
	if (open my $lf, '>>', $LOG)
	{
		print $lf "$ts $msg\n";
		close $lf;
	}
}

# Fire a desktop notification via the D-Bus Notify method and return the
# server-assigned id (or undef on failure).  We call gdbus directly rather than
# notify-send because Haven's libnotify is 0.7.9, which has NEITHER --print-id
# (to capture the id) NOR --replace-id (to replace a bubble in place) -- the two
# things this monitor's persistent-onset-then-replace design needs.  gdbus
# introspects the method, so the bare positional args below coerce to the right
# GVariant types (the multi-word strings -> 's', the hint dict -> 'a{sv}').
# Never let a notify failure kill the poll loop.
#
#   notify($urgency, $expire, $replaces, $title, $body)
#     $urgency : 0 low, 1 normal, 2 critical
#     $expire  : 0 = never auto-dismiss, or milliseconds to live
#     $replaces: 0 for a fresh bubble, or a prior id to replace in place
sub notify
{
	my ($urgency, $expire, $replaces, $title, $body) = @_;
	my $id;
	if (open my $fh, '-|', 'gdbus', 'call', '--session',
			'--dest',        'org.freedesktop.Notifications',
			'--object-path', '/org/freedesktop/Notifications',
			'--method',      'org.freedesktop.Notifications.Notify',
			'bulk-charge-mon', $replaces, 'battery-caution',
			$title, $body, '[]', "{'urgency': <byte $urgency>}", $expire)
	{
		my $out = <$fh>;
		close $fh;
		# reply looks like "(uint32 7,)"; anchor on the space so the "32" in
		# "uint32" can't be mistaken for the id.
		($id) = $out =~ /uint32\s+(\d+)/ if defined $out;
	}
	return $id;
}

# Title + body for the bulk-charge bubble, built from the live readings.  Both
# the onset and the in-place refreshes use this, so the wording stays in sync
# and the displayed numbers track the charge.
sub bulk_body
{
	my ($pct, $watts) = @_;
	return ('Haven is bulk-charging',
			sprintf 'Battery %s%%, drawing ~%.0f W to charge. This bubble stays up '
			      . 'until it tapers -- hold off on video over NoMachine until then.',
					$pct, $watts);
}

logline 'START monitoring';

my $in_bulk  = 0;
my $notif_id;       # id of the persistent onset bubble, so we can replace it
my $shown_pct;      # the % currently painted in that bubble (refresh on change)

while (1)
{
	my $status = rd('status')   // '';
	my $pct    = rd('capacity') // '?';
	my $watts  = charge_watts;

	if (not $in_bulk and $status eq 'Charging' and $watts >= $ENTER)
	{
		$in_bulk = 1;
		$shown_pct = $pct;
		logline sprintf 'BULK on  pct=%s%% charge=%.1fW', $pct, $watts;
		# urgency critical, expire 0 = never auto-dismiss (stays up until it
		# tapers), replaces 0 = a fresh bubble.
		$notif_id = notify 2, 0, 0, bulk_body($pct, $watts);
	}
	elsif ($in_bulk and ($status ne 'Charging' or $watts < $EXIT))
	{
		$in_bulk = 0;
		logline sprintf 'BULK off pct=%s%% charge=%.1fW status=%s', $pct, $watts, $status;
		# Replace the persistent onset bubble in place (pass its id as replaces)
		# with a transient normal-urgency all-clear that auto-dismisses (10s), so
		# the "still charging" bubble doesn't linger after it's done.
		notify 1, 10000, ($notif_id // 0),
				'Haven charging tapered',
				sprintf 'Battery %s%%, charge draw now low. GPU-heavy use is safer.', $pct;
		$notif_id = undef;
	}
	elsif ($in_bulk and $notif_id and $pct ne $shown_pct)
	{
		# Still bulk-charging and the battery % moved: refresh the SAME bubble in
		# place (replaces_id) so the number tracks the climb.  mate's daemon
		# updates a same-id notification quietly, with no re-pop (verified live
		# 2026-06-11).  Gated on integer-% change, so it refreshes ~once a minute
		# as the pack climbs, not on every poll.
		my $rid = notify 2, 0, $notif_id, bulk_body($pct, $watts);
		if (defined $rid)
		{
			$notif_id  = $rid;
			$shown_pct = $pct;
		}
	}

	sleep $POLL;
}

# Fall back to vt100 only when no usable terminal type was inherited
# (a genuinely dumb/unknown login).  Otherwise keep the real TERM --
# notably xterm-kitty forwarded in over ssh -- so screen renders color
# to the attached display instead of stripping it to monochrome vt100.
# (The old bare `set term=vt100' clobbered every interactive ssh login,
# which is why remote views of a screen session lost the prompt-bar tint.)
if ( ! $?term ) then
	set term=vt100
else if ( "$term" == "" || "$term" == "unknown" || "$term" == "dumb" ) then
	set term=vt100
endif
stty erase 

# turn on numlock (hopefully)
# setleds +num

# I think this fixes weird man/less/perldoc/Eterm interactions
if ( $?LANG ) then
	setenv LANGUAGES $LANG
else
	setenv LANGUAGES C
endif
setenv LC_ALL C
setenv LESSCHARSET utf-8

which fortune >&/dev/null
if ( $? == 0 ) then
	echo ""
	bfortune
	echo ""
endif

# allow local overrides to shared .login
if ( -e ~/.login.local ) then
	source ~/.login.local
endif

# initial login is same as a reset
set tcsh_reset

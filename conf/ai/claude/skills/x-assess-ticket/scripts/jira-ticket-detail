#!/usr/bin/env bash
# Get comprehensive ticket details including description, comments, and links
# Usage: jira-ticket-detail <TICKET>

ME=$(basename "$0")

ticket="$1"
if [[ -z "$ticket" ]]; then
    echo "Usage: $ME <TICKET>" >&2
    exit 1
fi

# Normalize ticket number (add CLASS- prefix if just a number)
if [[ "$ticket" =~ ^[0-9]+$ ]]; then
    ticket="CLASS-$ticket"
fi

# Get raw JSON
raw=$(jira issue view "$ticket" --raw 2>&1)
if [[ $? -ne 0 ]]; then
    echo "$ME: failed to fetch ticket: $raw" >&2
    exit 1
fi

# Basic info
summary=$(echo "$raw" | jq -r '.fields.summary // "N/A"')
status=$(echo "$raw" | jq -r '.fields.status.name // "N/A"')
issue_type=$(echo "$raw" | jq -r '.fields.issuetype.name // "N/A"')
priority=$(echo "$raw" | jq -r '.fields.priority.name // "N/A"')
created=$(echo "$raw" | jq -r '.fields.created // ""' | cut -dT -f1)
updated=$(echo "$raw" | jq -r '.fields.updated // ""' | cut -dT -f1)
assignee=$(echo "$raw" | jq -r '.fields.assignee.displayName // "Unassigned"')
reporter=$(echo "$raw" | jq -r '.fields.reporter.displayName // "Unknown"')

echo "# $ticket: $summary"
echo
echo "**Type:** $issue_type | **Status:** $status | **Priority:** $priority"
echo "**Assignee:** $assignee | **Reporter:** $reporter"
echo "**Created:** $created | **Updated:** $updated"
echo

# Labels
labels=$(echo "$raw" | jq -r '.fields.labels[]?' 2>/dev/null | tr '\n' ', ' | sed 's/,$//')
if [[ -n "$labels" ]]; then
    echo "**Labels:** $labels"
    echo
fi

# Description
echo "## Description"
echo
description=$(echo "$raw" | jq -r '.fields.description // ""')
if [[ -n "$description" && "$description" != "null" ]]; then
    # Description is often in ADF (Atlassian Document Format), extract text content
    echo "$description" | jq -r '
        if type == "object" and .content then
            def walk_content:
                if type == "array" then map(walk_content) | add // ""
                elif type == "object" then
                    if .type == "text" then .text // ""
                    elif .type == "paragraph" then ((.content | walk_content) // "") + "\n"
                    elif .type == "bulletList" then (.content | walk_content) // ""
                    elif .type == "orderedList" then (.content | walk_content) // ""
                    elif .type == "listItem" then "- " + ((.content | walk_content) // "") + "\n"
                    elif .type == "codeBlock" then "```\n" + ((.content | walk_content) // "") + "```\n"
                    elif .type == "heading" then "#" * (.attrs.level // 1) + " " + ((.content | walk_content) // "") + "\n"
                    elif .type == "hardBreak" then "\n"
                    elif .content then (.content | walk_content) // ""
                    else ""
                    end
                else ""
                end;
            .content | walk_content
        else
            . // "(No description)"
        end
    ' 2>/dev/null || echo "$description"
else
    echo "(No description)"
fi
echo

# Attachments
attachment_count=$(echo "$raw" | jq '.fields.attachment | length')
if [[ "$attachment_count" -gt 0 ]]; then
    echo "## Attachments ($attachment_count)"
    echo
    echo "$raw" | jq -r '.fields.attachment[] | "- \(.filename) (\(.size) bytes, \(.created | split("T")[0]))"'
    echo
fi

# Linked Issues
links=$(echo "$raw" | jq -c '.fields.issuelinks[]?' 2>/dev/null)
if [[ -n "$links" ]]; then
    echo "## Linked Issues"
    echo
    echo "$links" | while read -r link; do
        link_type=$(echo "$link" | jq -r '.type.name // "Unknown"')

        # Check if it's inward or outward link
        inward=$(echo "$link" | jq -r '.inwardIssue.key // empty')
        outward=$(echo "$link" | jq -r '.outwardIssue.key // empty')

        if [[ -n "$inward" ]]; then
            inward_summary=$(echo "$link" | jq -r '.inwardIssue.fields.summary // "N/A"')
            inward_status=$(echo "$link" | jq -r '.inwardIssue.fields.status.name // "N/A"')
            inward_desc=$(echo "$link" | jq -r '.type.inward // "relates to"')
            echo "- **$inward** ($inward_status) - $inward_desc: $inward_summary"
        fi

        if [[ -n "$outward" ]]; then
            outward_summary=$(echo "$link" | jq -r '.outwardIssue.fields.summary // "N/A"')
            outward_status=$(echo "$link" | jq -r '.outwardIssue.fields.status.name // "N/A"')
            outward_desc=$(echo "$link" | jq -r '.type.outward // "relates to"')
            echo "- **$outward** ($outward_status) - $outward_desc: $outward_summary"
        fi
    done
    echo
fi

# Comments
comments=$(echo "$raw" | jq -c '.fields.comment.comments[]?' 2>/dev/null)
if [[ -n "$comments" ]]; then
    comment_count=$(echo "$raw" | jq '.fields.comment.comments | length')
    echo "## Comments ($comment_count)"
    echo

    echo "$comments" | while read -r comment; do
        author=$(echo "$comment" | jq -r '.author.displayName // "Unknown"')
        created=$(echo "$comment" | jq -r '.created // ""' | cut -dT -f1)
        body=$(echo "$comment" | jq -r '.body')

        echo "### $author ($created)"
        echo

        # Parse ADF body to readable text
        echo "$body" | jq -r '
            if type == "object" and .content then
                def walk_content:
                    if type == "array" then map(walk_content) | add // ""
                    elif type == "object" then
                        if .type == "text" then .text // ""
                        elif .type == "paragraph" then ((.content | walk_content) // "") + "\n"
                        elif .type == "bulletList" then (.content | walk_content) // ""
                        elif .type == "orderedList" then (.content | walk_content) // ""
                        elif .type == "listItem" then "- " + ((.content | walk_content) // "") + "\n"
                        elif .type == "codeBlock" then "```\n" + ((.content | walk_content) // "") + "```\n"
                        elif .type == "hardBreak" then "\n"
                        elif .type == "mention" then "@" + (.attrs.text // "someone")
                        elif .content then (.content | walk_content) // ""
                        else ""
                        end
                    else ""
                    end;
                .content | walk_content
            else
                . // "(empty)"
            end
        ' 2>/dev/null || echo "$body"
        echo
    done
else
    echo "## Comments"
    echo
    echo "(No comments)"
fi

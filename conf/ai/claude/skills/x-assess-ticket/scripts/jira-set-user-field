#!/usr/bin/env bash
# Set a user-type custom field on a Jira issue via REST API
#
# The jira CLI (ankitpokhrel/jira-cli) does not support user-type fields
# via --custom (see https://github.com/ankitpokhrel/jira-cli/issues/758).
# This script works around that by calling the Jira REST API directly,
# authenticating via ~/.netrc (curl -n).
#
# Usage: jira-set-user-field <TICKET> <FIELD-ID> <ACCOUNT-ID>
#   TICKET     - Jira issue key (e.g., CLASS-155)
#   FIELD-ID   - Custom field ID (e.g., customfield_10157)
#   ACCOUNT-ID - Atlassian account ID to set

ME=$(basename "$0")
JIRA_BASE="https://archeredu.atlassian.net"

ticket="$1"
field_id="$2"
account_id="$3"

if [[ -z "$ticket" || -z "$field_id" || -z "$account_id" ]]
then
    echo "Usage: $ME <TICKET> <FIELD-ID> <ACCOUNT-ID>" >&2
    exit 1
fi

# Normalize ticket number (add CLASS- prefix if just a number)
if [[ "$ticket" =~ ^[0-9]+$ ]]
then
    ticket="CLASS-$ticket"
fi

# PUT the user field via REST API
response=$(curl -s -n -w "\n%{http_code}" -X PUT \
    "$JIRA_BASE/rest/api/2/issue/$ticket" \
    -H "Content-Type: application/json" \
    -d "{\"fields\":{\"$field_id\":{\"accountId\":\"$account_id\"}}}")

http_code=$(echo "$response" | tail -1)
body=$(echo "$response" | sed '$d')

if [[ "$http_code" -ge 200 && "$http_code" -lt 300 ]]
then
    echo "$ME: $ticket $field_id set to $account_id (HTTP $http_code)"
else
    echo "$ME: failed to set $field_id on $ticket (HTTP $http_code)" >&2
    if [[ -n "$body" ]]
    then
        echo "$body" >&2
    fi
    exit 1
fi

# Verify with a GET
verify=$(curl -s -n "$JIRA_BASE/rest/api/2/issue/$ticket?fields=$field_id")
actual_id=$(echo "$verify" | jq -r ".fields.$field_id.accountId // \"null\"")

if [[ "$actual_id" == "$account_id" ]]
then
    echo "$ME: verified - field is set correctly"
else
    echo "$ME: warning - verification returned accountId=$actual_id (expected $account_id)" >&2
    exit 1
fi
